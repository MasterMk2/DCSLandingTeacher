# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets
.env
*.local

# Runtime data
data/
*.sqlite3
*.db

# Node (frontend, later phases)
node_modules/
frontend/dist/
*.tsbuildinfo

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# External agent-tooling workspace (local only)
.commandcode/

# Tacview ACMI recordings: kept local only. Real captures run to tens or
# hundreds of MB and bloat the repo permanently once committed. The small
# parser/import fixture below is the exception the test suite needs.
*.acmi
*.acmi.zip
!backend/tests/fixtures/*.acmi
Testdata/

# Staged by the image build from config/*.yaml so the packaged copy cannot be
# hidden by a bind mount (docker/backend.Dockerfile). config/ stays the single
# canonical copy in git; committing this one would let the two drift.
backend/app/grading/defaults/
# Staged from config/runways/ by the image build, same as the YAMLs above.
backend/app/runways/defaults/
