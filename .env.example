# DCS Landing Teacher backend settings (pydantic-settings, prefix: DLT_)

# HTTP API server
DLT_HOST=0.0.0.0
DLT_PORT=8000

# PostgreSQL
DLT_POSTGRES_USER=dcs_landing_teacher
DLT_POSTGRES_PASSWORD=
DLT_POSTGRES_DB=dcs_landing_teacher

# Tacview realtime telemetry stream (ACMI 2.2 Text over TCP).
# The Real-Time Telemetry protocol requires a XtraLib handshake;
# set the client name and password to match your exporter settings.
DLT_TACVIEW_HOST=host.docker.internal
DLT_TACVIEW_PORT=42674
DLT_TACVIEW_CLIENT_NAME=DCSLandingTeacher
# Leave empty when the session is unprotected.
DLT_TACVIEW_PASSWORD=
# Single-source mode: treat this many seconds without telemetry as idle. Set
# to 0 to disable idle monitoring. Ignored when DLT_TACVIEW_SOURCES_JSON is set.
DLT_ACMI_IDLE_TIMEOUT=60
# Multiple telemetry sources. Leave empty to use the single-source values above.
# DLT_TACVIEW_SOURCES_JSON=[{"id":"server1","name":"Main","host":"host.docker.internal","port":42674,"password":"","client_name":"DCSLandingTeacher","idle_timeout":60,"enabled":true}]
DLT_TACVIEW_SOURCES_JSON=

# Set to false to disable the background ACMI client (e.g. for API-only usage)
DLT_ACMI_ENABLED=true

# Simple shared-token authentication (Issue #8). Leave empty (default) to
# disable authentication entirely. When set, REST endpoints under /api require
# "Authorization: Bearer <token>" or "X-Auth-Token", the WebSocket accepts
# "?token=<token>", while /api/health stays public.
DLT_AUTH_TOKEN=

# CORS origins allowed to call the API from a browser (JSON list).
# Leave empty for the reverse-proxy deployment. Example for the Vite dev server:
# DLT_CORS_ORIGINS=["http://localhost:5173"]
DLT_CORS_ORIGINS=[]

# Logging. Set structured logs only when the deployment consumes JSON logs.
DLT_STRUCTURED_LOGS=false
DLT_LOG_LEVEL=INFO

# ACMI file import (POST /api/import): maximum accepted upload size in MB.
# Larger uploads are rejected with HTTP 413.
DLT_IMPORT_MAX_UPLOAD_MB=200
# Delete abandoned imports after this many hours. Set to 0 to keep them until
# explicitly discarded.
DLT_IMPORT_RETENTION_HOURS=24

# Real runway geometry via DCSServerBot's RestAPI. Land landings are then
# graded against the actual threshold and runway heading instead of being
# inferred from the touchdown point. Leave DLT_DCSSB_BASE_URL empty to
# disable (the estimated geometry is used instead).
DLT_DCSSB_BASE_URL=
DLT_DCSSB_API_PREFIX=/stats
DLT_DCSSB_API_KEY=
# Restrict the runway sweep to one server. That server is only swept for the
# theatre it is actually running, so pinning it means landings on other maps
# get no runway. Empty (recommended) = whichever server is running the map the
# landing is on.
DLT_DCSSB_SERVER_NAME=
# `/airbase` executes Lua on the DCS *simulation thread*. Do not lower this:
# it is paid for directly in server frame time. A sweep runs once per map,
# then the result is cached on disk.
DLT_DCSSB_REQUEST_SPACING_MS=1500
DLT_DCSSB_TIMEOUT_S=10
DLT_RUNWAY_CACHE_DIR=cache
# Read-only runway geometry shipped with the build, for maps this server has
# never swept. A sweep needs the map loaded on a DCS server, so without these
# an import from a map nobody is flying cannot resolve at all.
DLT_RUNWAY_SEED_DIR=config/runways
