# DCS Landing Teacher backend settings (pydantic-settings, prefix: DLT_)

# HTTP API server
DLT_HOST=0.0.0.0
DLT_PORT=8000

# Database (SQLite via aiosqlite). Use a persistent volume path in production.
DLT_DATABASE_URL=sqlite+aiosqlite:///./data/dlt.db

# Apply Alembic migrations automatically at startup (recommended).
# Set to false to fall back to the legacy create_all bootstrap (dev mode).
DLT_MIGRATIONS_ON_STARTUP=true
# Explicit path to the Alembic scripts; leave empty to auto-detect next to
# the app package (containers: /app/migrations, set by the Dockerfile).
DLT_MIGRATIONS_DIR=

# Tacview realtime telemetry stream (ACMI 2.2 Text over TCP).
# The Real-Time Telemetry protocol requires a XtraLib handshake;
# set the client name and password to match your exporter settings.
DLT_TACVIEW_HOST=127.0.0.1
DLT_TACVIEW_PORT=31010
DLT_TACVIEW_CLIENT_NAME=DCSLandingTeacher
# Leave empty when the session is unprotected.
DLT_TACVIEW_PASSWORD=

# Set to false to disable the background ACMI client (e.g. for API-only usage)
DLT_ACMI_ENABLED=true

# Automatic reconnection (exponential backoff)
DLT_RECONNECT_INITIAL_DELAY=1.0
DLT_RECONNECT_MAX_DELAY=30.0

# Simple shared-token authentication (Issue #8). Leave empty (default) to
# disable authentication entirely. When set, REST endpoints under /api require
# "Authorization: Bearer <token>" or "X-Auth-Token", the WebSocket accepts
# "?token=<token>", while /api/health and the SPA static hosting stay public.
DLT_AUTH_TOKEN=

# CORS origins allowed to call the API from a browser (JSON list).
# Leave empty for the single-container deployment where this app serves the
# built frontend itself. Example for the Vite dev server:
#   DLT_CORS_ORIGINS=["http://localhost:5173"]
DLT_CORS_ORIGINS=

# Per-carrier FLOLS geometry (Issue #3). All shipped values are unverified
# estimates; see config/carriers.yaml before trusting them.
DLT_CARRIERS_CONFIG_PATH=config/carriers.yaml

# Built frontend directory served in production (SPA). When missing, the API
# runs without static file hosting.
DLT_FRONTEND_DIST_DIR=frontend/dist

# ACMI file import (POST /api/import): maximum accepted upload size in MB.
# Larger uploads are rejected with HTTP 413.
DLT_IMPORT_MAX_UPLOAD_MB=200

# Real runway geometry via DCSServerBot's RestAPI. Land landings are then
# graded against the actual threshold and runway heading instead of being
# inferred from the touchdown point. Leave DLT_DCSSB_BASE_URL empty to
# disable (the estimated geometry is used instead).
DLT_DCSSB_BASE_URL=
DLT_DCSSB_API_PREFIX=/stats
DLT_DCSSB_API_KEY=
# Restrict the runway sweep to one server; empty = first server reporting a
# theatre.
DLT_DCSSB_SERVER_NAME=
# `/airbase` executes Lua on the DCS *simulation thread*. Do not lower this:
# it is paid for directly in server frame time. A sweep runs once per map,
# then the result is cached on disk.
DLT_DCSSB_REQUEST_SPACING_MS=1500
DLT_DCSSB_TIMEOUT_S=10
DLT_RUNWAY_CACHE_DIR=cache
